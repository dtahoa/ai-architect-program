OPENAI_API_KEY=sk-your-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_TOKENS_PER_BATCH=8000
EMBEDDING_MIN_DELAY_MS=750
EMBEDDING_MAX_RETRIES=4

DATABASE_URL=postgres://copilot:copilot@localhost:5432/insurance_copilot
API_PORT=8080
WEB_PORT=5173

# Approximate model prices in USD per 1M tokens. Keep configurable because pricing changes.
CHAT_INPUT_PRICE_PER_1M=0.40
CHAT_OUTPUT_PRICE_PER_1M=1.60
EMBEDDING_PRICE_PER_1M=0.02

